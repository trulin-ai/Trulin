  "units": [
    {
      "unit_id": "SRC-P03-01",
      "type": "prose",
      "section": "1. Introduction and Scope",
      "page": 3,
      "verbatim_text": "Northwind Outfitters Inc. (\"Northwind\", \"we\", \"us\") is a fictional online and retail seller of outdoor gear, clothing and equipment.",
      "role": "non_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P03-02",
      "type": "prose",
      "section": "1. Introduction and Scope",
      "page": 3,
      "verbatim_text": "This handbook sets out our complete refund, return and cancellation policies for customers, customer care agents and retail store staff.",
      "role": "non_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P03-03",
      "type": "prose",
      "section": "1. Introduction and Scope",
      "page": 3,
      "verbatim_text": "Business customers on standard accounts (custom contracts take precedence).",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-01",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Refund: Return of money to the original payment method or store credit following an approved return or cancellation.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-02",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Return: Sending a purchased item back to Northwind by mail or in-store drop-off.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-03",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Exchange: Replacing an item with a different size, colour or product of equal or greater value.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-04",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Store Credit: A balance issued to a customer account, redeemable online and in stores, valid for 5 years.",
      "role": "operative_rule",
      "notes": "Note: Valid for 5 years, expires."
    },
    {
      "unit_id": "SRC-P04-05",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "RMA: Return Merchandise Authorization number, e.g. RMA-2026-004815, required for mailed returns.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-06",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Delivery Date: The date the carrier marks the package as delivered, as shown in the tracking record.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-07",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Final Sale: Items marked 'Final Sale' at the time of purchase, which cannot be returned.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-08",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Original Condition: Unused, unwashed, with all tags, packaging and accessories included.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P04-09",
      "type": "definition",
      "section": "2. Definitions",
      "page": 4,
      "verbatim_text": "Business Day: Monday to Friday, excluding US federal holidays.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-01",
      "type": "prose",
      "section": "3. Standard Return Policy",
      "page": 5,
      "verbatim_text": "Most items purchased from Northwind may be returned within 30 calendar days of the delivery date (or purchase date for in-store sales) for a full refund of the item price, provided the item is in original condition.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-02",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Standard merchandise | 30 days",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-03",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Northwind Rewards Gold members | 60 days",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-04",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Holiday purchases (Nov 1 - Dec 24) | Until January 31 of the following year",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-05",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Footwear (worn indoors only) | 45 days",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-06",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Camping tents and sleeping bags (unused) | 60 days",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-07",
      "type": "table_row",
      "section": "3.1 Extended windows",
      "page": 5,
      "verbatim_text": "Defective items | Covered by warranty - see Section 14",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-08",
      "type": "prose",
      "section": "3.2 Returns without a receipt",
      "page": 5,
      "verbatim_text": "Returns without proof of purchase are accepted in-store only, for store credit at the lowest price the item was sold in the last 90 days. A government-issued photo ID is required and scanned. A limit of three receipt-less returns per customer per 12-month period applies.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P05-09",
      "type": "prose",
      "section": "3.3 Exchanges",
      "page": 5,
      "verbatim_text": "Exchanges for a different size or colour are free of charge, including shipping both ways, when requested within the return window and when the replacement item is in stock.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-01",
      "type": "prose",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "To be eligible for a refund, all of the following conditions must be met. Support agents must verify each condition before approving a refund over $50.00.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-02",
      "type": "bullet",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "The request is made within the applicable return window.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-03",
      "type": "bullet",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "The item is in original condition: unused, unwashed, undamaged, with original tags attached.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-04",
      "type": "bullet",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "The item is returned with all accessories, manuals, free gifts and original packaging where practical.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-05",
      "type": "bullet",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "The order number or proof of purchase can be verified in our systems.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-06",
      "type": "bullet",
      "section": "4. Refund Eligibility Criteria",
      "page": 6,
      "verbatim_text": "The item is not on the non-refundable list in Section 5.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-07",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Like new, tags attached | 100%",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-08",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Opened packaging, item unused | 100%",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-09",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Missing original box (non-fragile) | 90%",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-10",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Missing accessories or free gift | Refund minus gift value",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-11",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Light wear or signs of use | 50% - 75%",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-12",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Damaged by customer / heavy use | 0% - 25% (agent discretion, manager approval)",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-13",
      "type": "table_row",
      "section": "4.1 Partial refunds",
      "page": 6,
      "verbatim_text": "Washed, altered or stained | Not eligible",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-14",
      "type": "bullet",
      "section": "4.2 Manager approval thresholds",
      "page": 6,
      "verbatim_text": "Up to $100: Tier 1 agent may approve.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-15",
      "type": "bullet",
      "section": "4.2 Manager approval thresholds",
      "page": 6,
      "verbatim_text": "$100.01 - $500: Tier 2 agent or team lead approval required.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-16",
      "type": "bullet",
      "section": "4.2 Manager approval thresholds",
      "page": 6,
      "verbatim_text": "Over $500: Customer Experience Manager approval required.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P06-17",
      "type": "bullet",
      "section": "4.2 Manager approval thresholds",
      "page": 6,
      "verbatim_text": "Over $2,000: Finance Director approval and fraud review required.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-01",
      "type": "prose",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "The following items cannot be returned or refunded, except where the item is defective or we sent the wrong item.",
      "role": "operative_rule",
      "notes": "Parent exception clause"
    },
    {
      "unit_id": "SRC-P07-02",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Items marked Final Sale or Clearance - All Sales Final at checkout.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-03",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Gift cards and e-gift cards (see Section 13).",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-04",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Downloadable software, digital guides and trail-map files once downloaded.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-05",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Personalised or custom-engraved items, including monogrammed jackets and embroidered packs.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-06",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Opened hygiene items: water bottles' mouthpieces, thermal underwear, socks, and swimwear without liner tags.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-07",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Fuel canisters, bear spray, and other hazardous materials once opened or shipped.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-08",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Perishable goods such as freeze-dried meals past 14 days from delivery.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-09",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Installation, repair, and gear-fitting services already performed.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P07-10",
      "type": "bullet",
      "section": "5. Non-Refundable Items",
      "page": 7,
      "verbatim_text": "Items returned more than 90 days after delivery.",
      "role": "operative_rule",
      "notes": "Note: 90 days threshold, not 60 days."
    },
    {
      "unit_id": "SRC-P07-11",
      "type": "prose",
      "section": "5.2 Exceptions",
      "page": 7,
      "verbatim_text": "Even for non-refundable items, a full refund or replacement will be provided if the item arrives damaged, is materially different from its description, or was shipped in error. Report these issues within 7 days of delivery with photos.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P08-01",
      "type": "prose",
      "section": "6.1 Online portal",
      "page": 8,
      "verbatim_text": "Navigate to returns.northwind-demo.example. Enter your order number and billing postcode.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P08-02",
      "type": "contact",
      "section": "6.2 By phone or chat",
      "page": 8,
      "verbatim_text": "Call 1-800-555-0142 (Mon-Fri 8am-8pm PT, Sat 9am-5pm PT) or use live chat.",
      "role": "non_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P08-03",
      "type": "prose",
      "section": "6.3 In-store returns",
      "page": 8,
      "verbatim_text": "Bring item, original packaging, and receipt/order confirmation email to any store.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P08-04",
      "type": "table_row",
      "section": "6.4 Required information",

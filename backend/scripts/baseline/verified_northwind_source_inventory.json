      "notes": null
    },
    {
      "unit_id": "SRC-P10-07",
      "type": "prose",
      "section": "8.3 Store credit bonus",
      "page": 10,
      "verbatim_text": "Customers who choose store credit instead of a refund to their card receive a 5% bonus on the credit value (up to a maximum bonus of $25.00 per return). Bonus credit cannot be applied retroactively once a refund has been issued to the card.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-01",
      "type": "table_row",
      "section": "9. Shipping Costs and Return Labels",
      "page": 11,
      "verbatim_text": "Standard merchandise, change of mind | $5.99 deducted from refund",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-02",
      "type": "table_row",
      "section": "9. Shipping Costs and Return Labels",
      "page": 11,
      "verbatim_text": "Defective or damaged | Free | Full refund including original shipping",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-03",
      "type": "table_row",
      "section": "9. Shipping Costs and Return Labels",
      "page": 11,
      "verbatim_text": "Wrong item sent | Free | Full refund including original shipping",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-04",
      "type": "table_row",
      "section": "9. Shipping Costs and Return Labels",
      "page": 11,
      "verbatim_text": "Exchange (size/colour) | Free both ways | Replacement shipped free",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-05",
      "type": "table_row",
      "section": "9. Shipping Costs and Return Labels",
      "page": 11,
      "verbatim_text": "Gold member, any reason | Free | Full refund of item price",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P11-06",
      "type": "prose",
      "section": "9.2 Oversized and freight items",
      "page": 11,
      "verbatim_text": "Return freight for change-of-mind returns is a flat $49.00, deducted from the refund. Freight pickups must be scheduled with our logistics team at least 3 business days in advance.",
      "role": "operative_rule",
      "notes": null
    },
    {
      "unit_id": "SRC-P12-01",
      "type": "prose",
      "section": "10. Damaged, Defective or Incorrect Items",
      "page": 12,
